# Local development defaults. Copy to .env before using docker compose.
APP_ENV=development
APP_PORT=8000

POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://jarvis:local-development-only@postgres:5432/jarvis

QDRANT_URL=http://vector-db:6333
QDRANT_COLLECTION=jarvis_memory
